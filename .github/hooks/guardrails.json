{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "edit",
        "bash": "python3 .github/hooks/scripts/block_service_key_edits.py \"$COPILOT_TOOL_ARG_PATH\"",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit",
        "bash": "python3 .github/hooks/scripts/run_scoped_tests.py \"$COPILOT_TOOL_ARG_PATH\"",
        "timeoutSec": 60
      },
      {
        "type": "command",
        "matcher": "edit",
        "bash": "python3 .github/hooks/scripts/vercel_build_check.py \"$COPILOT_TOOL_ARG_PATH\"",
        "timeoutSec": 100
      }
    ],
    "permissionRequest": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/scripts/deny_destructive_commands.py",
        "timeoutSec": 5
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "matcher": "reviewer",
        "bash": "python3 .github/hooks/scripts/enforce_clean_review.py \"$COPILOT_SUBAGENT_OUTPUT\"",
        "timeoutSec": 10
      }
    ]
  }
}
