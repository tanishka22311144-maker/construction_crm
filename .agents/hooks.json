{
  "construction-crm-guardrails": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "python3 .agents/hooks/deny_destructive_commands.py" }
        ]
      },
      {
        "matcher": ".*(write|edit|create).*",
        "hooks": [
          { "type": "command", "command": "python3 .agents/hooks/block_service_key_edits.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*(write|edit|create).*",
        "hooks": [
          { "type": "command", "command": "python3 .agents/hooks/run_scoped_tests.py" },
          { "type": "command", "command": "python3 .agents/hooks/vercel_build_check.py" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 .agents/hooks/enforce_clean_review.py" }
        ]
      }
    ]
  }
}
